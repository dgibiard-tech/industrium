{
  "name": "industrium",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w @industrium/api\" \"npm run dev -w @industrium/web\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "db:generate": "npm run db:generate -w @industrium/api",
    "db:migrate": "npm run db:migrate -w @industrium/api",
    "db:seed": "npm run db:seed -w @industrium/api"
  },
  "devDependencies": { "concurrently": "^9.2.1" }
}
